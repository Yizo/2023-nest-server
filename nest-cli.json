{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"monorepo": true,
	"root": "apps/admin-api",
	"sourceRoot": "apps/admin-api/src",
	"compilerOptions": {
		"deleteOutDir": true,
		"webpack": false
	},
	"generateOptions": {
		"spec": false,
		"flat": false
	},
	"projects": {
		"admin-api": {
			"type": "application",
			"root": "apps/admin-api",
			"entryFile": "main",
			"sourceRoot": "apps/admin-api/src",
			"compilerOptions": {
				"tsConfigPath": "apps/admin-api/tsconfig.build.json"
			}
		}
	}
}
