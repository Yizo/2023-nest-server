{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"monorepo": true,
	"root": "apps/survey-statistics",
	"sourceRoot": "apps/survey-statistics/src",
	"compilerOptions": {
		"deleteOutDir": true
	},
	"generateOptions": {
		"spec": false,
		"flat": false
	},
	"projects": {
		"survey-statistics": {
			"type": "application",
			"root": "apps/survey-statistics",
			"entryFile": "main",
			"sourceRoot": "apps/survey-statistics/src",
			"compilerOptions": {
				"tsConfigPath": "apps/survey-statistics/tsconfig.build.json"
			}
		},
		"commons": {
			"type": "library",
			"root": "packages/commons",
			"entryFile": "index",
			"sourceRoot": "packages/commons",
			"compilerOptions": {
				"tsConfigPath": "packages/commons/tsconfig.json"
			}
		},
		"utils": {
			"type": "library",
			"root": "packages/utils",
			"entryFile": "index",
			"sourceRoot": "packages/utils",
			"compilerOptions": {
				"tsConfigPath": "packages/utils/tsconfig.json"
			}
		}
	}
}
