{
	// ==========================================
	// NestJS CLI 配置文件（Monorepo 模式）
	// ==========================================

	// JSON Schema - 提供 IDE 智能提示和配置验证
	"$schema": "https://json.schemastore.org/nest-cli",

	// 原理图集合 - 用于代码生成的模板集合
	"collection": "@nestjs/schematics",

	// ==========================================
	// 默认项目配置
	// ==========================================

	// 默认项目的源代码根目录
	"sourceRoot": "apps/survey-statistics/src",

	// 标识为 Monorepo 模式（true = Monorepo，false/不设置 = 标准模式）
	"monorepo": true,

	// 默认项目的根目录（不指定项目名时使用此项目）
	"root": "apps/survey-statistics",

	// ==========================================
	// 全局编译选项
	// ==========================================
	"compilerOptions": {
		// 使用 tsc 编译器（false）还是 webpack（true）
		// false - 保留文件结构，调试友好
		// true - 打包为单文件，构建速度快
		"webpack": false,

		// 默认项目的 TypeScript 配置文件路径
		"tsConfigPath": "apps/survey-statistics/tsconfig.app.json",

		// 编译前是否删除输出目录
		// false - 增量编译，速度快（开发推荐）
		// true - 完全清空，构建干净（生产推荐）
		"deleteOutDir": false,

		// 是否监视非 TypeScript 资源文件（yml、json 等）
		// 在 watch 模式下自动复制变更的资源文件
		"watchAssets": true
	},

	// ==========================================
	// 全局生成选项
	// ==========================================
	"generateOptions": {
		// 生成代码时是否自动创建测试文件
		// false - 不生成 .spec.ts 文件
		// true - 自动生成测试文件
		"spec": false,

		// 生成代码时是否使用扁平结构
		// false - 为每个模块创建独立文件夹（推荐）
		// true - 文件直接生成在指定目录
		"flat": false
	},

	// ==========================================
	// 项目配置
	// ==========================================
	"projects": {
		// ------------------------------------------
		// 应用：nest-admin
		// ------------------------------------------
		"nest-admin": {
			// 项目类型：application（应用）或 library（库）
			"type": "application",

			// 项目根目录
			"root": "apps/nest-admin",

			// 入口文件名（不含扩展名，实际文件：src/main.ts）
			"entryFile": "main",

			// 源代码目录
			"sourceRoot": "apps/nest-admin/src",

			// 项目级编译选项
			"compilerOptions": {
				// 此项目的 TypeScript 配置文件
				"tsConfigPath": "apps/nest-admin/tsconfig.app.json"
			}
		},

		// ------------------------------------------
		// 应用：survey-statistics（默认项目）
		// ------------------------------------------
		"survey-statistics": {
			"type": "application",
			"root": "apps/survey-statistics",
			"entryFile": "main",
			"sourceRoot": "apps/survey-statistics/src",
			"compilerOptions": {
				"tsConfigPath": "apps/survey-statistics/tsconfig.app.json",

				// 需要复制到构建产物的资源文件
				// 路径相对于 sourceRoot (src)
				// 文件必须在 src 目录内才能被复制
				"assets": [
					"config/*.yml", // config 目录下的所有 yml 文件
					"config/*.yaml", // config 目录下的所有 yaml 文件
					"logs/.gitignore" // logs 目录的 .gitignore 文件
				]
			}
		},

		// ------------------------------------------
		// 库：commons（共享通用模块）
		// ------------------------------------------
		"commons": {
			// 库类型 - 不可独立运行，提供可复用功能
			"type": "library",
			"root": "packages/commons",

			// 库的导出文件（实际文件：index.ts）
			"entryFile": "index",

			// 库的源代码目录（库通常不需要 src 子目录）
			"sourceRoot": "packages/commons",
			"compilerOptions": {
				"tsConfigPath": "packages/commons/tsconfig.json"
			}
		},

		// ------------------------------------------
		// 库：utils（工具函数库）
		// ------------------------------------------
		"utils": {
			"type": "library",
			"root": "packages/utils",
			"entryFile": "index",
			"sourceRoot": "packages/utils",
			"compilerOptions": {
				"tsConfigPath": "packages/utils/tsconfig.json"
			}
		}
	}

	// ==========================================
	// 使用提示：
	// ==========================================
	//
	// 1. 启动默认项目：
	//    pnpm start
	//    pnpm start:dev
	//    pnpm build
	//
	// 2. 启动指定项目：
	//    nest start nest-admin
	//    nest build nest-admin
	//
	// 3. 生成新代码：
	//    nest g module user
	//    nest g controller user
	//    nest g service user
	//
	// 4. 添加新应用：
	//    nest generate app my-app
	//
	// 5. 添加新库：
	//    nest generate library my-lib
	//
	// ==========================================
	// 注意事项：
	// ==========================================
	//
	// 1. 资源文件必须放在 src 目录内才能被 assets 处理
	// 2. 修改配置后需要重启 watch 模式
	// 3. 尽量使用 nest generate 命令而不是手动修改此文件
	// 4. 项目级 compilerOptions 会覆盖全局配置
	// 5. 命令行参数优先级最高
	//
	// ==========================================
}
