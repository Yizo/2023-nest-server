{
  "name": "nest-admin",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "cross-env NODE_ENV=production nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:up": "cd ../../ && docker-compose -f apps/test-project/docker/docker-compose.yml up -d",
    "docker:down": "cd ../../ && docker-compose -f apps/test-project/docker/docker-compose.yml down -v",
    "docker:logs": "cd ../../ && docker-compose -f apps/test-project/docker/docker-compose.yml logs -f",
    "docker:init": "npm run docker:build && npm run docker:up",
    "docker:build": "cd ../../ && docker-compose -f apps/test-project/docker/docker-compose.yml build",
    "docker:reset": "npm run docker:down && npm run docker:up",
    "docker:start": "npm run docker:build && npm run docker:up",
    "dist": "cross-env NODE_ENV=production node dist/src/main",
    "pm2:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "npm run build && pm2 start ecosystem.config.js --env development",
    "pm2:del": "pm2 delete all",
    "db:init": "ts-node --transpile-only scripts/database-init.ts",
    "db:reset": "npm run docker:down && npm run docker:up && npm run db:init",
    "migration:create": "cross-env NODE_ENV=development ts-node scripts/database-migration.ts create",
    "migration:run": "cross-env NODE_ENV=development ts-node scripts/database-migration.ts run",
    "migration:rollback": "cross-env NODE_ENV=development ts-node scripts/database-migration.ts rollback",
    "migration:status": "cross-env NODE_ENV=development ts-node scripts/database-migration.ts status",
    "migration:generate": "cross-env NODE_ENV=development ts-node scripts/database-migration.ts generate",
    "migration:backup": "cross-env NODE_ENV=development ts-node scripts/database-migration.ts backup",
    "migration:restore": "cross-env NODE_ENV=development ts-node scripts/database-migration.ts restore"
  },
  "dependencies": {
    "@nestjs/mapped-types": "*"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
