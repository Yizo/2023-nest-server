# PostgreSQL 连接地址：本地开发使用独立的 greenfield 数据库，不连接旧系统数据库。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survey_statistics_greenfield
# Redis 连接地址：11 是本地开发使用的 Redis database 编号，避免和其他项目混用。
REDIS_URL=redis://localhost:6379/11
# API 在本机监听的端口。
PORT=3003
# Access Token 签名密钥；这里只是本地开发值，生产环境必须注入随机密钥。
JWT_ACCESS_SECRET=local-development-access-secret-change-me
# Refresh Token 签名密钥；必须和 Access Token 使用不同的值。
JWT_REFRESH_SECRET=local-development-refresh-secret-change-me
# 开发阶段允许任意前端来源；生产环境必须改成明确的前端域名。
CORS_ORIGINS=*
# 是否启用 Swagger 接口文档，开发阶段打开方便学习和调试。
SWAGGER_ENABLED=true
# 最低日志级别；info 会同时保留 warn 和 error。
LOG_LEVEL=info
# 是否生成本地按日期滚动的日志文件。
LOG_FILE_ENABLED=true
# 本地日志目录；相对路径以仓库根目录为基准。
LOG_DIR=apps/survey-statistics/logs
# 单个日志文件达到该大小后滚动生成新文件。
LOG_MAX_SIZE=20m
# 本地日志文件最长保留天数。
LOG_MAX_FILES=14d
# 首次初始化时创建的平台所有者邮箱。
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# 首次初始化时创建的平台所有者用户名，登录时不区分大小写。
BOOTSTRAP_ADMIN_USERNAME=superAdmin
# 平台所有者在管理界面显示的名称。
BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Owner
# 本地开发管理员密码；生产环境不要使用明文环境变量，应改用 Secret 文件。
BOOTSTRAP_ADMIN_PASSWORD=local-owner-password-change-me
