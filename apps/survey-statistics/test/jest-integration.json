{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "../",
	"testRegex": ".integration-spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapper": {
		"^@/(.*)$": "<rootDir>/src/$1",
		"^@base/commons$": "<rootDir>/../../packages/commons",
		"^@base/commons/(.*)$": "<rootDir>/../../packages/commons/$1",
		"^@base/utils$": "<rootDir>/../../packages/utils",
		"^@base/utils/(.*)$": "<rootDir>/../../packages/utils/$1"
	},
	"setupFiles": ["<rootDir>/test/setup-env.ts"],
	"collectCoverageFrom": ["**/*.(t|j)s"],
	"coverageDirectory": "../coverage",
	"testEnvironment": "node",
	"testTimeout": 30000
}
