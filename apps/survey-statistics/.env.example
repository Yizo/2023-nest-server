POSTGRES_USER=survey
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=survey_statistics_greenfield
DATABASE_URL=postgresql://survey:replace-with-a-long-database-password@localhost:5432/survey_statistics_greenfield
REDIS_URL=redis://localhost:6379/0
APP_PORT=3003
PORT=3003
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_DIR=apps/survey-statistics/logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Owner
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-development-password
