{
  "name": "survey-statistics",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=22.17.0" },
  "scripts": {
    "build": "nest build",
    "start": "node -r ./scripts/register-runtime-alias.cjs dist/main.js",
    "start:dev": "cross-env NODE_ENV=development PROCESS_ROLE=all NODE_OPTIONS=--require=./scripts/register-runtime-alias.cjs nest start --watch",
    "start:debug": "cross-env NODE_ENV=development PROCESS_ROLE=all NODE_OPTIONS=--require=./scripts/register-runtime-alias.cjs nest start --debug --watch",
    "start:api": "cross-env PROCESS_ROLE=api node -r ./scripts/register-runtime-alias.cjs dist/main.js",
    "start:worker": "cross-env PROCESS_ROLE=worker node -r ./scripts/register-runtime-alias.cjs dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest.config.ts --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest.config.ts --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest.config.ts --runInBand --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.ts --runInBand",
    "db:status": "ts-node -r tsconfig-paths/register src/tools/cli.ts migration-status",
    "db:migrate": "ts-node -r tsconfig-paths/register src/tools/cli.ts migrate",
    "db:init": "ts-node -r tsconfig-paths/register src/tools/cli.ts init",
    "db:rollback": "ts-node -r tsconfig-paths/register src/tools/cli.ts rollback",
    "db:create-migration": "ts-node -r tsconfig-paths/register src/tools/cli.ts migration-create",
    "db:bootstrap-admin": "ts-node -r tsconfig-paths/register src/tools/cli.ts bootstrap-admin",
    "db:orphan-check": "ts-node -r tsconfig-paths/register src/tools/cli.ts orphan-check",
    "queue:schedule:sync": "ts-node -r tsconfig-paths/register src/tools/cli.ts queue-schedule-sync",
    "queue:failed": "ts-node -r tsconfig-paths/register src/tools/cli.ts queue-failed",
    "queue:retry-failed": "ts-node -r tsconfig-paths/register src/tools/cli.ts queue-retry-failed",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore": "sh scripts/db-restore.sh"
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.9",
    "@mikro-orm/decorators": "7.1.9",
    "@mikro-orm/migrations": "7.1.9",
    "@mikro-orm/nestjs": "7.0.0",
    "@mikro-orm/postgresql": "7.1.9",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.1.28",
    "argon2": "0.44.0",
    "bullmq": "5.81.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "nest-winston": "1.10.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "uuid": "11.1.0",
    "tsconfig-paths": "4.2.0",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.1.9",
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.28",
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.11.0"
}
