{
	"name": "admin-api",
	"version": "0.1.0",
	"private": true,
	"description": "Minimal NestJS backend scaffold for the admin API",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"build": "nest build",
		"start": "node dist/main.js",
		"start:prod": "nest build && node dist/main.js",
		"start:dev": "bash scripts/start-dev.sh",
		"pack:release": "bash scripts/pack-release.sh",
		"ssh:tunnel": "bash scripts/ssh-tunnel.sh",
		"typecheck": "tsc --noEmit",
		"test": "jest --config test/jest.config.cjs --runInBand",
		"test:watch": "jest --config test/jest.config.cjs --watch",
		"test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.cjs --runInBand"
	},
	"dependencies": {
		"@mikro-orm/core": "7.1.13",
		"@mikro-orm/postgresql": "7.1.13",
		"@nestjs/common": "11.2.1",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.2.1",
		"@nestjs/platform-express": "11.2.1",
		"@nestjs/swagger": "11.4.7",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"dotenv-flow": "4.1.0",
		"helmet": "8.1.0",
		"ioredis": "6.0.0",
		"nest-winston": "1.10.2",
		"pg": "8.23.0",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"winston": "3.19.0",
		"winston-daily-rotate-file": "5.0.0"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.24",
		"@nestjs/schematics": "11.0.9",
		"@nestjs/testing": "11.2.1",
		"@types/express": "5.0.3",
		"@types/jest": "29.5.14",
		"@types/node": "26.2.0",
		"@types/supertest": "6.0.3",
		"jest": "29.7.0",
		"supertest": "7.1.4",
		"ts-jest": "29.4.12",
		"typescript": "6.0.3"
	}
}
