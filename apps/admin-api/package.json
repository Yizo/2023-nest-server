{
	"name": "admin-api",
	"version": "1.0.0",
	"private": true,
	"description": "Minimal NestJS backend scaffold for the admin API",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"build": "nest build",
		"start": "node dist/main.js",
		"start:prod": "node dist/main.js",
		"start:dev": "bash scripts/start-dev.sh",
		"pack:release": "bash scripts/pack-release.sh",
		"ssh:tunnel": "bash scripts/ssh-tunnel.sh",
		"db:migration:create": "mikro-orm migration:create --config ./src/infrastructure/database/mikro-orm.config.ts",
		"db:migration:check": "mikro-orm migration:check --config ./src/infrastructure/database/mikro-orm.config.ts",
		"db:migration:up": "mikro-orm migration:up --config ./src/infrastructure/database/mikro-orm.config.ts",
		"db:migration:up:prod": "mikro-orm migration:up --config ./dist/infrastructure/database/mikro-orm.config.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@mikro-orm/cli": "7.1.13",
		"@mikro-orm/core": "7.1.13",
		"@mikro-orm/migrations": "7.1.13",
		"@mikro-orm/nestjs": "7.0.2",
		"@mikro-orm/postgresql": "7.1.13",
		"@nestjs/common": "11.2.1",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.2.1",
		"@nestjs/platform-express": "11.2.1",
		"@nestjs/swagger": "11.4.7",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"dotenv-flow": "4.1.0",
		"helmet": "8.1.0",
		"nest-winston": "1.10.2",
		"pg": "8.23.0",
		"redis": "6.2.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"winston": "3.19.0",
		"winston-daily-rotate-file": "5.0.0"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.24",
		"@nestjs/schematics": "11.0.9",
		"@types/express": "5.0.3",
		"@types/node": "26.2.0",
		"typescript": "6.0.3"
	}
}
