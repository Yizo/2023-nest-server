# production 应用基础配置；数据库和 Redis 连接信息必须由系统环境变量提供。
# 线上地址、账号、密码不写入此文件。

# 生产环境标识。
NODE_ENV=production
# HTTP 服务监听端口。
PORT=3004
# 应用名称。
APP_NAME=admin-api

# production 直接访问云服务器本机服务，不使用 SSH 隧道。
# DATABASE_URL 和 REDIS_URL 由 1Panel/systemd/容器环境变量注入。
DATABASE_SYNCHRONIZE=false
DB_DEBUG=false

# 生产环境使用明确的前端域名，不使用通配符。
CORS_ORIGINS=https://your-frontend.example.com
CORS_CREDENTIALS=false
# production 默认关闭 Swagger。
SWAGGER_ENABLED=false

# Winston 本地滚动日志配置。
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=90d
