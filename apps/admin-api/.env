# development 基础配置；真实服务器连接信息全部放在 .env.local。
# 配置优先级：系统环境变量 > .env.local > .env > 代码默认值。

# 应用运行环境。
NODE_ENV=development
# HTTP 服务监听端口。
PORT=3004
# 应用名称。
APP_NAME=admin-api

# PostgreSQL、Redis 和 SSH 配置只放 .env.local，不在基础文件中配置。
DATABASE_SYNCHRONIZE=false
DB_DEBUG=false

# 开发阶段允许前端来源。
CORS_ORIGINS=*
CORS_CREDENTIALS=false
# 开发环境启用 Swagger。
SWAGGER_ENABLED=true

# Winston 本地日志配置。
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=20d
